<?xml version="1.0" encoding="utf-8"?>
<!-- Spacious layout for large widgets (4x2+, 4x4): bigger type, all 8 reciter rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg_day">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recitations_widget_title"
        android:textSize="17sp"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="17sp"
        android:autoSizeStepGranularity="0.5sp"
        android:textColor="@color/widget_title"
        android:fontFamily="@font/tajawal_bold"
        android:layout_marginStart="8dp" />

    <LinearLayout
        android:id="@+id/reciter_1_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/chip_bg_day"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/reciter_1_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textSize="15sp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeStepGranularity="0.5sp"
            android:textColor="@color/chip_text"
            android:fontFamily="@font/tajawal_medium" />

        <ImageView
            android:id="@+id/play_reciter_1"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_media_play"
            android:contentDescription="@string/recitations_play"
            android:scaleType="centerInside"
            android:padding="7dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/reciter_2_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
