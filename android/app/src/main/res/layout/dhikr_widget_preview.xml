<?xml version="1.0" encoding="utf-8"?>
<!-- Preview-only layout for Android 12+ widget picker (previewLayout). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg_day">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/dhikr_widget_title"
            android:textColor="#00674F"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/tajawal_bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="@drawable/chip_bg_day"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="05:00–12:00"
            android:textColor="#14B8A6"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="@font/tajawal_medium" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="أَصْبِحْنَا وَأَصْبَحَ الْمُلْكُ لِلَّهِ"
        android:textColor="#1A1A1A"
        android:textSize="15sp"
        android:fontFamily="@font/tajawal_medium" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end"
        android:text="We have entered the morning and the dominion belongs to Allah."
        android:textColor="#1A1A1A"
        android:textSize="12sp"
        android:alpha="0.65"
        android:fontFamily="@font/tajawal_medium" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="2dp"
        android:background="@drawable/chip_bg_day"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="صحيح مسلم"
        android:textColor="#14B8A6"
        android:textSize="11sp"
        android:textStyle="bold"
        android:fontFamily="@font/tajawal_medium" />
</LinearLayout>
