<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/clock_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_clock"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="مواقيت الصلاة"
            android:textSize="16sp"
            android:textColor="@color/widget_title"
            android:fontFamily="@font/tajawal_bold"
            android:layout_marginStart="8dp" />

        <ImageView
            android:id="@+id/location_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_mylocation"
            android:contentDescription="تحديث الموقع"
            android:scaleType="centerInside"
            android:padding="7dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:id="@+id/chip_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/chip_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:layout_marginEnd="3dp">

            <TextView
                android:id="@+id/prayer_fajr_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textSize="13sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeStepGranularity="0.5sp"
                android:textColor="@color/chip_text"
                android:fontFamily="@font/tajawal_medium" />
            <TextView
                android:id="@+id/prayer_fajr_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textSize="11sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeStepGranularity="0.5sp"
                android:fontFamily="@font/tajawal_medium"
                android:textColor="@color/chip_text"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chip_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/chip_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp">

            <TextView
                android:id="@+id/prayer_dhuhr_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الظهر"
                android:textSize="13sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeStepGranularity="0.5sp"
                android:textColor="@color/chip_text"
                android:fontFamily="@font/tajawal_medium" />
            <TextView
                android:id="@+id/prayer_dhuhr_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textSize="11sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeStepGranularity="0.5sp"
                android:fontFamily="@font/tajawal_medium"
                android:textColor="@color/chip_text"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chip_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/chip_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp">

            <TextView
                android:id="@+id/prayer_asr_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="العصر"
                android:textSize="13sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeStepGranularity="0.5sp"
                android:textColor="@color/chip_text"
                android:fontFamily="@font/tajawal_medium" />
            <TextView
                android:id="@+id/prayer_asr_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textSize="11sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeStepGranularity="0.5sp"
                android:fontFamily="@font/tajawal_medium"
                android:textColor="@color/chip_text"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chip_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/chip_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp">

            <TextView
                android:id="@+id/prayer_maghrib_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="المغرب"
                android:textSize="13sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeStepGranularity="0.5sp"
                android:textColor="@color/chip_text"
                android:fontFamily="@font/tajawal_medium" />
            <TextView
                android:id="@+id/prayer_maghrib_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textSize="11sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeStepGranularity="0.5sp"
                android:fontFamily="@font/tajawal_medium"
                android:textColor="@color/chip_text"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chip_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/chip_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:layout_marginStart="3dp">

            <TextView
                android:id="@+id/prayer_isha_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="العشاء"
                android:textSize="13sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeStepGranularity="0.5sp"
                android:textColor="@color/chip_text"
                android:fontFamily="@font/tajawal_medium" />
            <TextView
                android:id="@+id/prayer_isha_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textSize="11sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeStepGranularity="0.5sp"
                android:fontFamily="@font/tajawal_medium"
                android:textColor="@color/chip_text"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
