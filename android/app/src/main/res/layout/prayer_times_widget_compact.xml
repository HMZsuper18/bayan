<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/clock_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_clock"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="مواقيت الصلاة"
            android:textSize="12sp"
            android:textColor="@color/widget_title"
            android:fontFamily="@font/tajawal_bold"
            android:layout_marginStart="4dp" />

        <ImageView
            android:id="@+id/location_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_mylocation"
            android:contentDescription="تحديث الموقع"
            android:scaleType="centerInside"
            android:padding="5dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:id="@+id/compact_chip_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/chip_bg"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_marginEnd="2dp">

            <TextView
                android:id="@+id/compact_prayer_fajr_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="الفجر"
                android:textSize="10sp"
                android:textColor="@color/chip_text"
                android:fontFamily="@font/tajawal_medium" />
            <TextView
                android:id="@+id/compact_prayer_fajr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textSize="9sp"
                android:textColor="@color/chip_text"
                android:fontFamily="@font/tajawal_medium"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/compact_chip_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/chip_bg"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp">

            <TextView
                android:id="@+id/compact_prayer_dhuhr_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="الظهر"
                android:textSize="10sp"
                android:textColor="@color/chip_text"
                android:fontFamily="@font/tajawal_medium" />
            <TextView
                android:id="@+id/compact_prayer_dhuhr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textSize="9sp"
                android:textColor="@color/chip_text"
                android:fontFamily="@font/tajawal_medium"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/compact_chip_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/chip_bg"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_marginStart="2dp">

            <TextView
                android:id="@+id/compact_prayer_asr_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="العصر"
                android:textSize="10sp"
                android:textColor="@color/chip_text"
                android:fontFamily="@font/tajawal_medium" />
            <TextView
                android:id="@+id/compact_prayer_asr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textSize="9sp"
                android:textColor="@color/chip_text"
                android:fontFamily="@font/tajawal_medium"
                android:layout_marginStart="2dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <LinearLayout
            android:id="@+id/compact_chip_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/chip_bg"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_marginEnd="2dp">

            <TextView
                android:id="@+id/compact_prayer_maghrib_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="المغرب"
                android:textSize="10sp"
                android:textColor="@color/chip_text"
                android:fontFamily="@font/tajawal_medium" />
            <TextView
                android:id="@+id/compact_prayer_maghrib_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textSize="9sp"
                android:textColor="@color/chip_text"
                android:fontFamily="@font/tajawal_medium"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/compact_chip_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/chip_bg"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_marginStart="2dp">

            <TextView
                android:id="@+id/compact_prayer_isha_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="العشاء"
                android:textSize="10sp"
                android:textColor="@color/chip_text"
                android:fontFamily="@font/tajawal_medium" />
            <TextView
                android:id="@+id/compact_prayer_isha_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textSize="9sp"
                android:textColor="@color/chip_text"
                android:fontFamily="@font/tajawal_medium"
                android:layout_marginStart="2dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
