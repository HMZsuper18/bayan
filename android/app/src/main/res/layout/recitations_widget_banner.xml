<?xml version="1.0" encoding="utf-8"?>
<!-- Short banner for 1-cell-tall widgets (2x1, 4x1): tight header + up to 2 reciter rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="@drawable/widget_bg_day">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recitations_widget_title"
        android:textSize="11sp"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="11sp"
        android:autoSizeStepGranularity="0.5sp"
        android:textColor="@color/widget_title"
        android:fontFamily="@font/tajawal_bold"
        android:layout_marginStart="4dp" />

    <LinearLayout
        android:id="@+id/reciter_1_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/chip_bg_day"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_marginTop="3dp">

        <TextView
            android:id="@+id/reciter_1_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textSize="10sp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="10sp"
            android:autoSizeStepGranularity="0.5sp"
            android:textColor="@color/chip_text"
            android:fontFamily="@font/tajawal_medium" />

        <ImageView
            android:id="@+id/play_reciter_1"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@android:drawable/ic_media_play"
            android:contentDescription="@string/recitations_play"
            android:scaleType="centerInside"
            android:padding="3dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/reciter_2_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/chip_bg_day"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/reciter_2_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textSize="10sp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="10sp"
            android:autoSizeStepGranularity="0.5sp"
            android:textColor="@color/chip_text"
            android:fontFamily="@font/tajawal_medium" />

        <ImageView
            android:id="@+id/play_reciter_2"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@android:drawable/ic_media_play"
            android:contentDescription="@string/recitations_play"
            android:scaleType="centerInside"
            android:padding="3dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/reciter_3_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
