<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2: title + 6 reciter chips as a 3-column x 2-row grid. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg_day">

    <LinearLayout
        android:id="@+id/title_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:scaleType="fitStart"
            android:adjustViewBounds="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rows_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/reciter_1_row"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/chip_bg_day"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="5dp">
                <ImageView
                    android:id="@+id/reciter_1_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true" />

                <ImageView
                    android:id="@+id/play_reciter_1"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_widget_play"
                    android:contentDescription="@string/recitations_play"
                    android:scaleType="centerInside"
                    android:padding="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reciter_2_row"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/chip_bg_day"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="5dp">
                <ImageView
                    android:id="@+id/reciter_2_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true" />

                <ImageView
                    android:id="@+id/play_reciter_2"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_widget_play"
                    android:contentDescription="@string/recitations_play"
                    android:scaleType="centerInside"
                    android:padding="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reciter_3_row"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/chip_bg_day"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">
                <ImageView
                    android:id="@+id/reciter_3_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true" />

                <ImageView
                    android:id="@+id/play_reciter_3"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_widget_play"
                    android:contentDescription="@string/recitations_play"
                    android:scaleType="centerInside"
                    android:padding="4dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginTop="5dp">

            <LinearLayout
                android:id="@+id/reciter_4_row"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/chip_bg_day"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="5dp">
                <ImageView
                    android:id="@+id/reciter_4_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true" />

                <ImageView
                    android:id="@+id/play_reciter_4"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_widget_play"
                    android:contentDescription="@string/recitations_play"
                    android:scaleType="centerInside"
                    android:padding="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reciter_5_row"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/chip_bg_day"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="5dp">
                <ImageView
                    android:id="@+id/reciter_5_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true" />

                <ImageView
                    android:id="@+id/play_reciter_5"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_widget_play"
                    android:contentDescription="@string/recitations_play"
                    android:scaleType="centerInside"
                    android:padding="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reciter_6_row"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/chip_bg_day"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">
                <ImageView
                    android:id="@+id/reciter_6_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true" />

                <ImageView
                    android:id="@+id/play_reciter_6"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_widget_play"
                    android:contentDescription="@string/recitations_play"
                    android:scaleType="centerInside"
                    android:padding="4dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/chip_bg_day"
        android:layout_marginTop="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/empty_state_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true" />
    </LinearLayout>
</LinearLayout>
